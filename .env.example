APP_NAME="Photo Gallery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Public URL where this app is served. Used to build absolute URLs
# (signed download links, password-gate cookies, Vite asset paths).
# Must match the real domain, including scheme — no trailing slash.
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gallery
DB_USERNAME=gallery
DB_PASSWORD=

# Session driver + cookie settings.
# SESSION_DOMAIN must match (or be a parent of) the domain the app
# is served from, otherwise admin login will redirect-loop.
# Set to ".your-domain.com" if serving from a subdomain
# (e.g. gallery.your-domain.com) to share cookies across subdomains.
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
